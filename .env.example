# Base URL of the Copilot API (copilot-api/). Server-side only: used by the CopilotKit runtime
# route and the /api/backend proxy, never exposed to the browser.
COPILOT_API_URL=http://localhost:8000

# CopilotKit runtime sends anonymous telemetry by default; keep it off for the demo.
COPILOTKIT_TELEMETRY_DISABLED=true
