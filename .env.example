# Copy to .env.local (ignored by git). `next dev` reloads it on save, no restart needed.

# "mock" (default): every call answers from lib/mock and the UI shows the "Datos de ejemplo" badge.
# "hybrid": the endpoints the deployed backend already serves (lib/api/liveRoutes.ts) go to NEXT_PUBLIC_API_URL, the
#           rest keeps answering from lib/mock (badge still shown).
# "http": every call goes to the backend at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_MODE=mock

# Base URL of the backend API (Go Lambdas behind API Gateway, see BackendRoad2Tech api/README.md).
NEXT_PUBLIC_API_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com

# Optional, "mock" and "hybrid": comma-separated path prefixes forced to the real backend on top of the mode while the
# rest stays as is. "/chat" tries the real assistant (listing any path also sends the login, /auth, to the backend).
# The backend has no /drafts yet (docs/backend-contract.md D26): with "/chat" listed and "/drafts" not, proposals from
# the real chat are read-only.
NEXT_PUBLIC_API_HTTP_PATHS=

# Keep "compat" until the updated chat Lambda is deployed. Switch to "backend" to send chain-level trend,
# stock sufficiency and waste-risk questions to POST /chat too.
NEXT_PUBLIC_CHAT_ANALYSIS_SOURCE=compat

# Copilot chat (/copilot). Base URL of BackendRoad2Tech services/copilot-api. Server-side only: used by the
# CopilotKit runtime route and the /api/backend proxy, never exposed to the browser.
COPILOT_API_URL=http://localhost:8000

# CopilotKit runtime sends anonymous telemetry by default; keep it off for the demo.
COPILOTKIT_TELEMETRY_DISABLED=true
