# Copy to .env.local (ignored by git). `next dev` reloads it on save, no restart needed.

# "mock" (default): every call answers from lib/mock and the UI shows the "Datos de ejemplo" badge.
# "http": every call goes to the backend at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_MODE=mock

# Base URL of the backend API (Go Lambdas behind API Gateway, see BackendRoad2Tech api/README.md).
NEXT_PUBLIC_API_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com

# Mock mode only, optional: comma-separated path prefixes answered by the real backend while the rest stays on
# sample data. "/chat" tries the real assistant (listing any path also sends the login, /auth, to the backend).
# The backend does not implement stores, KPIs, map, plan or drafts yet (docs/backend-contract.md D20-D21), so full
# "http" mode cannot pick a store. With "/chat" listed and "/drafts" not, proposals from the real chat are read-only.
NEXT_PUBLIC_API_HTTP_PATHS=

# Keep "compat" until the updated chat Lambda is deployed. Switch to "backend" to send chain-level trend,
# stock sufficiency and waste-risk questions to POST /chat too.
NEXT_PUBLIC_CHAT_ANALYSIS_SOURCE=compat
